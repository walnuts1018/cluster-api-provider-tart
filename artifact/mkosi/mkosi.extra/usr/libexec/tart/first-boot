#!/bin/sh
set -eu

state_dir="${TART_STATE_DIR:-/var/lib/tart}"
bootstrap_work_dir="${TART_BOOTSTRAP_WORK_DIR:-/run/tart/bootstrap}"
controller_trust_dir="${TART_CONTROLLER_TRUST_DIR:-/etc/tart}"
active_slot_file="${TART_ACTIVE_SLOT_FILE:-/etc/tart/active-slot}"
artifact_generation_file="${TART_ARTIFACT_GENERATION_FILE:-/etc/tart/artifact-generation}"
bootstrap_adapter="${TART_BOOTSTRAP_ADAPTER:-/usr/libexec/tart/apply-cloud-config}"
system_uuid="${TART_SYSTEM_UUID:-}"

mkdir -p "$state_dir" "$bootstrap_work_dir"

active_slot="$(tr -d '[:space:]' < "$active_slot_file")"
artifact_generation="$(tr -d '[:space:]' < "$artifact_generation_file")"
boot_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/boot_id)"

state_mounted=""
data_mounted=""
if findmnt -T "$state_dir" >/dev/null 2>&1; then
  state_mounted="--state-mounted"
fi
if findmnt -T /var/lib/kubelet >/dev/null 2>&1; then
  data_mounted="--data-mounted"
fi

root_source="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
root_options="$(findmnt -n -o OPTIONS / 2>/dev/null || true)"
root_read_only="false"
if printf '%s\n' "$root_options" | grep -Eq '(^|,)ro(,|$)'; then
  root_read_only="true"
fi

printf 'TART_QEMU_ROOT_SOURCE=%s\n' "$root_source"
printf 'TART_QEMU_ROOT_OPTIONS=%s\n' "$root_options"
printf 'TART_QEMU_ROOT_READ_ONLY=%s\n' "$root_read_only"

/usr/bin/provisioning-agent \
  --apply-bootstrap-only \
  --system-uuid="$system_uuid" \
  --tls-ca-file="$controller_trust_dir/agent-tls.crt" \
  --plan-key-id="${TART_PLAN_KEY_ID:-e2e-agent-plan}" \
  --plan-key-file="$controller_trust_dir/agent-plan-public.pem" \
  --state-dir="$state_dir" \
  --bootstrap-work-dir="$bootstrap_work_dir" \
  --bootstrap-adapter="$bootstrap_adapter"

/usr/bin/provisioning-agent \
  --report-boot-only \
  --system-uuid="$system_uuid" \
  --tls-ca-file="$controller_trust_dir/agent-tls.crt" \
  --plan-key-id="${TART_PLAN_KEY_ID:-e2e-agent-plan}" \
  --plan-key-file="$controller_trust_dir/agent-plan-public.pem" \
  --state-dir="$state_dir" \
  --bootstrap-work-dir="$bootstrap_work_dir" \
  --boot-id="$boot_id" \
  --active-slot="$active_slot" \
  --artifact-generation="$artifact_generation" \
  $state_mounted \
  $data_mounted
