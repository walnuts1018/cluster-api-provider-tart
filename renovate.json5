{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>walnuts1018/renovate-config"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "CAPI本体とCAPI関連moduleを同じreleaseへ更新する",
      "matchPackageNames": [
        "kubernetes-sigs/cluster-api",
        "sigs.k8s.io/cluster-api",
        "sigs.k8s.io/cluster-api/test"
      ],
      "groupName": "Cluster API"
    },
    {
      "description": "Kubernetes Go moduleとkubectlを同じreleaseへ更新する",
      "matchPackageNames": [
        "kubernetes/kubernetes",
        "kubectl",
        "k8s.io/{/,}**"
      ],
      "groupName": "Kubernetes"
    },
    {
      "description": "Talos本体moduleとmachinery moduleを同じreleaseへ更新する。cluster-wide Kubernetes upgradeでupstream実装を直接利用するため、両者のversionは常に一致させる",
      "matchPackageNames": [
        "github.com/siderolabs/talos",
        "github.com/siderolabs/talos/pkg/machinery"
      ],
      "groupName": "Talos"
    },
    {
      "description": "Go moduleとmiseのGo toolchainを同じtoolchainへ更新する",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain"
    }
  ]
}
