{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>walnuts1018/renovate-config',
  ],
  ignorePaths: ['hack/renovate/**'],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^config/.*/kustomization.yaml$/',
        '/^test/utils/utils.go$/',
      ],
      matchStringsStrategy: 'any',
      matchStrings: [
        'https:\\/\\/github\\.com\\/(?<depName>.*?)\\/releases\\/download\\/(?<currentValue>[^\\/]+)\\/.*\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>.*?)\\/refs\\/tags\\/(?<currentValue>[^\\/]+)\\/.*\\s*',
        'https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>[^/]+\\/[^/]+?)\\/(?<currentValue>[^\\/]+?)\\/.*\\s*',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^artifact/mkosi/mkosi\\.conf$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^ ]+)\\n\\s+[^=\\n]+=v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:-[0-9.]+)?',
      ],
      versioningTemplate: 'semver-coerced',
    },
  ],
  packageRules: [
    {
      description: 'テスト用の存在しないprivate registryを依存関係として扱わない',
      matchDatasources: ['docker'],
      matchPackageNames: ['registry.test.walnuts.dev/cluster-api-provider-tart'],
      enabled: false,
    },
  ],
}
