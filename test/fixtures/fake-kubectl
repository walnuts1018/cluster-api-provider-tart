#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  "get deployments.apps,statefulsets.apps,services,configmaps,secrets,persistentvolumeclaims --namespace lifecycle-e2e --output json")
    jq -n '{
      items: [
        {
          apiVersion: "v1",
          kind: "Secret",
          metadata: {namespace: "lifecycle-e2e", name: "identity", uid: "secret-uid"},
          data: {value: "secret-value"}
        },
        {
          apiVersion: "v1",
          kind: "PersistentVolumeClaim",
          metadata: {
            namespace: "lifecycle-e2e",
            name: "data",
            uid: "pvc-uid",
            annotations: {
              "tart.infrastructure.cluster.x-k8s.io/preservation-reader-pod": "data-0",
              "tart.infrastructure.cluster.x-k8s.io/preservation-payload-path": "/data/payload.bin"
            }
          }
        }
      ]
    }'
    ;;
  "get persistentvolumes --output json")
    jq -n '{
      items: [
        {
          apiVersion: "v1",
          kind: "PersistentVolume",
          metadata: {name: "data-pv", uid: "pv-uid"},
          spec: {claimRef: {namespace: "lifecycle-e2e", name: "data"}}
        }
      ]
    }'
    ;;
  "version --output json")
    jq -n '{serverVersion: {gitVersion: "v1.36.2"}}'
    ;;
  "exec --namespace lifecycle-e2e data-0 -- sha256sum /data/payload.bin")
    printf '%s  /data/payload.bin\n' 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
    ;;
  *)
    echo "unexpected kubectl arguments: $*" >&2
    exit 1
    ;;
esac
